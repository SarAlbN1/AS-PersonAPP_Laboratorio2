# Copiar a .env y ajustar. .env no se versiona.
# Contraseña de root de MariaDB y MongoDB; solo la usan los contenedores de las bases.
PERSONAPP_ROOT_PW=cambie-esta-clave

# Usuario de la aplicación. Debe coincidir con el que crean los scripts DDL (persona_db).
PERSONAPP_DB_USER=persona_db
PERSONAPP_DB_PASSWORD=persona_db

# Puerto publicado de REST y zona horaria de la JVM.
PERSONAPP_REST_PORT=3000
PERSONAPP_TZ=America/Bogota
